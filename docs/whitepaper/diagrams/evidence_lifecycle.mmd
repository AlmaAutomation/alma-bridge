    REG --> DEC[Decision]
    DEC --> REV[Review]
    REV --> VAL[Validation]
    VAL --> GOV[Governance]
    GOV --> EXP[Expansion Planning]
    EXP --> HIST[Historical Evidence]

    subgraph bundle [CompatibilityEvidenceBundle]
