    L2 --> STO
    L1 --> STO
    STO --> INT
    INT --> G4
    INT --> G5
    INT --> G6
    INT --> G7
    INT --> CAT
    G4 --> G5
    G5 --> G6
    G5 --> G7
    G6 --> G8
    G5 --> G8
    G8 --> G9
    G5 --> CAT

