# Alma Bridge — copy to .env (optional). All vars use prefix ALMA_BRIDGE_.

# --- Core API ---
ALMA_BRIDGE_API_HOST=127.0.0.1
ALMA_BRIDGE_API_PORT=9010

ALMA_BRIDGE_DATA_DIR=data
ALMA_BRIDGE_DB_PATH=data/outcomes.db
ALMA_BRIDGE_MAX_ATTEMPTS=8
ALMA_BRIDGE_EXECUTION_TIMEOUT_SEC=120

# --- Sandbox / container lab ---
ALMA_BRIDGE_SANDBOX_ENABLED=true
ALMA_BRIDGE_SANDBOX_IMAGE=alma-bridge-sandbox:latest

# --- Compliance probes ---
# ALMA_BRIDGE_COMPLIANCE_CA_FILE=
# ALMA_BRIDGE_COMPLIANCE_TLS_TIMEOUT=6.0
# ALMA_BRIDGE_COMPLIANCE_SYS_ROOT=/sys
# ALMA_BRIDGE_COMPLIANCE_DRIVER_CATALOG_DB=../automatic driver detection/driver_compatibility.db
# ALMA_BRIDGE_COMPLIANCE_BRIDGE_LISTEN_HOST=127.0.0.1
# ALMA_BRIDGE_COMPLIANCE_MAX_WORKERS=0
# ALMA_BRIDGE_COMPLIANCE_CACHE_TTL=60.0

# --- Automation webhooks (comma-separated URLs) ---
# ALMA_BRIDGE_AUTOMATION_WEBHOOK_URLS=

# --- API key (optional — protects apply/run/import when set) ---
# ALMA_BRIDGE_API_KEY=change-me-in-production
# Send as header: X-API-Key: <key>  or  Authorization: Bearer <key>

# --- Commercial data retention (automation audit rows) ---
# ALMA_BRIDGE_COMPLIANCE_DATA_RETENTION_DAYS=365

# --- AI Operator (autonomous modernization/self-healing) ---
# Master switch for the background loop (off by default).
# ALMA_BRIDGE_OPERATOR_ENABLED=false
# Autonomy: observe | recommend | assisted | autonomous
# ALMA_BRIDGE_OPERATOR_AUTONOMY=recommend
# Must ALSO be true before the operator will change a host:
# ALMA_BRIDGE_OPERATOR_ALLOW_MUTATIONS=false
# ALMA_BRIDGE_OPERATOR_INTERVAL_SEC=900
# Highest risk the operator may auto-apply: low | medium | high
# ALMA_BRIDGE_OPERATOR_MAX_RISK=low
# ALMA_BRIDGE_OPERATOR_MIN_CONFIDENCE=0.7
# Apply every mitigation/step within max_risk (autonomous + mutations only).
# ALMA_BRIDGE_OPERATOR_APPLY_ALL=true
# ALMA_BRIDGE_OPERATOR_MAX_ROUTE_ATTEMPTS=12
# ALMA_BRIDGE_OPERATOR_BRIDGE_MAX_ATTEMPTS=12
# ALMA_BRIDGE_OPERATOR_TRY_ALL_PATHWAYS=true

# --- Bridge auto-compatibility (winetricks, pathways, best routes after retries) ---
# ALMA_BRIDGE_BRIDGE_AUTO_REMEDIATE=true

# --- Legacy import sources (override if repos live elsewhere) ---
# ALMA_BRIDGE_SYSDET_DB_PATH=../almasysdet/data/alma.db
# ALMA_BRIDGE_RESOLVE_AUDIT_DIR=../alma_resolve/runtime_data/audit
